{
  "name": "@herrlich-digital/trycatch-wrapper",
  "description": "A simple try-catch wrapper for TypeScript inspired by Golang",
  "version": "1.0.10",
  "entrypoint": "index.ts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check-all": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "try",
    "catch",
    "trycatch",
    "wrapper",
    "typescript"
  ],
  "author": "Christoph Planken <Herrlich Digital>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Herrlich-Digital/tryCatch-Wrapper.git"
  }
}
